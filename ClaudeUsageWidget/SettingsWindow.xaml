<Window x:Class="ClaudeUsageWidgetProvider.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Title="Claude Usage Widget Settings">
    <Window.Resources>
        <!-- Paleta (Windows 11 dark) -->
        <SolidColorBrush x:Key="WindowBg" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="WindowBorder" Color="#404040"/>
        <SolidColorBrush x:Key="CardBg" Color="#333333"/>
        <SolidColorBrush x:Key="CardBorder" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Checkbox jako přepínač: text vlevo, switch vpravo -->
        <Style x:Key="ToggleRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="34" Height="18" CornerRadius="9"
                                    Background="#3A3A3A" BorderBrush="#6A6A6A" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="10" Height="10" Fill="#CFCFCF"
                                         HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Width" Value="12"/>
                                <Setter TargetName="Knob" Property="Height" Value="12"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: tenká dráha, vyplněná část v accent barvě, kulatý thumb -->
        <Style x:Key="SliderRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="14" Height="14" Fill="White"
                                 Stroke="{StaticResource AccentBrush}" StrokeThickness="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeat}"
                                                  Background="{StaticResource AccentBrush}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeat}"
                                                  Background="#505050"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="18,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Okraj kolem okna = místo pro stín (SettingsWindow.ShadowMargin). Stín je na samostatném
         Borderu za obsahem, aby DropShadowEffect nerozmazával text. -->
    <Grid Margin="14">
        <Border CornerRadius="10" Background="{StaticResource WindowBg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="10" Background="{StaticResource WindowBg}"
                BorderBrush="{StaticResource WindowBorder}" BorderThickness="1"
                Padding="16,14,16,14"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <StackPanel Width="290">
                <!-- Hlavička -->
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Settings" Foreground="{StaticResource TextBrush}"
                               FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Zobrazení -->
                <TextBlock Text="Display" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="ShowClaudeCheck" Content="Claude" Style="{StaticResource ToggleRow}"/>
                        <CheckBox x:Name="ShowCodexCheck" Content="Codex" Style="{StaticResource ToggleRow}"/>
                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,4"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tile width (px)" Foreground="{StaticResource TextBrush}" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <TextBox x:Name="TileWidthBox" Grid.Column="1" Height="22"/>
                        </Grid>
                        <CheckBox x:Name="PrimaryMonitorOnlyCheck" Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <TextBlock Text="Primary monitor only"/>
                                <TextBlock Text="Takes effect after restart" Foreground="{StaticResource SubTextBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Plovoucí režim -->
                <TextBlock Text="Floating window" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="FloatingModeCheck" Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <TextBlock Text="Floating mode"/>
                                <TextBlock Text="Drag anywhere · always on top" Foreground="{StaticResource SubTextBrush}"
                                           FontSize="10"/>
                            </StackPanel>
                        </CheckBox>
                        <StackPanel x:Name="FloatingOptions">
                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Background" Style="{StaticResource Caption}"/>
                            <Slider x:Name="BgOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="BgOpacityText" Grid.Column="2" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Window" Style="{StaticResource Caption}"/>
                            <Slider x:Name="WindowOpacitySlider" Grid.Column="1" Minimum="20" Maximum="100"
                                    SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="WindowOpacityText" Grid.Column="2" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Limity (plní se v kódu, až jsou známé labely) -->
                <StackPanel x:Name="LimitsCard" Visibility="Collapsed">
                    <TextBlock Text="Limits" Style="{StaticResource SectionHeader}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="LimitsPanel"/>
                    </Border>
                </StackPanel>

                <!-- Ostatní -->
                <TextBlock Text="Notifications &amp; startup" Style="{StaticResource SectionHeader}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="NotificationsCheck" Content="Alert at 75% and 90%"
                                  Style="{StaticResource ToggleRow}"/>
                        <CheckBox x:Name="NotifyResetCheck" Content="Notify on limit reset"
                                  Style="{StaticResource ToggleRow}"/>
                        <CheckBox x:Name="StartupCheck" Content="Run at startup"
                                  Style="{StaticResource ToggleRow}"/>
                    </StackPanel>
                </Border>

                <!-- Patička -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                    <Button x:Name="QuitButton" Content="Quit" Style="{StaticResource FlatButton}"
                            Background="Transparent" BorderBrush="#8A4A4A" Foreground="#FF9A90"
                            Margin="0,0,8,0" ToolTip="Exit the widget"/>
                    <Button x:Name="CloseButton" Content="Close" Style="{StaticResource FlatButton}"
                            Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
