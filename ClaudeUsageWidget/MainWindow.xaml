<Window x:Class="ClaudeUsageWidgetProvider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Height="48"
        Title="Claude Usage Widget">
  <!-- RootBorder: holds the CombinedPanel (inserted in code). In floating mode it gets a dark
       rounded background (readable on any backdrop + catches the mouse for dragging). -->
  <Border x:Name="RootBorder" CornerRadius="6"
          MouseRightButtonUp="OnRightClick"/>
</Window>
