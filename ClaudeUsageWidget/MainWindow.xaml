<Window x:Class="ClaudeUsageWidgetProvider.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Height="48"
        Title="Claude Usage Widget">
  <!-- RootBorder: obsahuje CombinedPanel (vkládá se v kódu). V plovoucím režimu dostane tmavé
       zaoblené pozadí (čitelnost na libovolném podkladu + chytání myši pro drag). -->
  <Border x:Name="RootBorder" CornerRadius="6"
          MouseRightButtonUp="OnRightClick"/>
</Window>
