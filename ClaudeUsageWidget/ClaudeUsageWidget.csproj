<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for NotifyIcon (toast notifications without the 25 MB Windows SDK projection) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Company>Štěpán Zrník</Company>
    <Product>Claude Usage Widget</Product>
    <Copyright>Copyright © 2026 Štěpán Zrník</Copyright>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1</Version>
    <ApplicationIcon>Assets\claude.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\claude-logo.png" />
    <Resource Include="Assets\codex-logo.png" />
    <Content Include="Assets\claude.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms/Drawing global usings would clash with WPF types (Application, Color, Point…) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
